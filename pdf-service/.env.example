DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
MAX_VISUAL_ELEMENTS_PER_PAGE=3

# Optional visual AI correction layer. Disabled by default; parsing works without
# DASHSCOPE_API_KEY and skips this layer when the key is missing.
ENABLE_VISION_AI=false
VISION_AI_PROVIDER=qwen-vl
QWEN_VL_MODEL=qwen3-vl-plus
VISION_AI_PROVIDER_ORDER=volcengine_ark_vl,qwen_vl,mimo_vl
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_ENDPOINT_ID=
ARK_VISION_MODEL=doubao-seed-2-0-lite-260215
ARK_MODEL=doubao-seed-1-6-vision-250815
ARK_API_MODE=responses
ARK_RESPONSES_PATH=/responses
VISION_AI_TIMEOUT_SECONDS=60
VISION_AI_MAX_RETRIES=2
VISION_AI_CONFIDENCE_THRESHOLD=0.75

# Optional AI question solving assist through Alibaba Bailian / DashScope.
# Reuses DASHSCOPE_API_KEY only.
ENABLE_AI_SOLVER=false
AI_SOLVER_PROVIDER=bailian-deepseek
BAILIAN_DEEPSEEK_FAST_MODEL=
BAILIAN_DEEPSEEK_REASONER_MODEL=
BAILIAN_DEEPSEEK_PRO_MODEL=
BAILIAN_DEEPSEEK_DEFAULT_MODEL=
BAILIAN_DEEPSEEK_MODEL=deepseek-r1
AI_SOLVER_SCOPE=review_only
AI_SOLVER_CONFIDENCE_THRESHOLD=0.7
AI_SOLVER_TIMEOUT_SECONDS=60
AI_SOLVER_MAX_RETRIES=2
ENABLE_AI_SOLVER_PRO_RECHECK=false
AI_SOLVER_PRO_RECHECK_THRESHOLD=0.75

# PDF layout extractor:
# - pymupdf: current lightweight extractor
# - mineru: use MinerU CLI first, then fallback unless MINERU_STRICT=true
# - auto: use MinerU when the CLI is installed, otherwise PyMuPDF
PDF_LAYOUT_ENGINE=pymupdf
MINERU_BIN=mineru
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_LANG=ch
MINERU_TIMEOUT_SECONDS=900
MINERU_STRICT=false

# Commercial OCR first stage
COMMERCIAL_OCR_ENABLED=false
COMMERCIAL_OCR_REAL_SMOKE=false
PDF_PARSE_PRIMARY_PROVIDER=mock_commercial_ocr
PDF_PARSE_FALLBACK_PROVIDERS=local_parser,mock_commercial_ocr
OCR_PROVIDER_TRACE_ENABLED=true

# Baidu paper_cut_edu
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_ACCESS_TOKEN=
BAIDU_OCR_ENDPOINT=https://aip.baidubce.com/rest/2.0/ocr/v1/paper_cut_edu
BAIDU_OCR_TIMEOUT_MS=60000

# Tencent question split
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
TENCENT_OCR_ENDPOINT=https://ocr.tencentcloudapi.com
TENCENT_OCR_VERSION=2018-11-19
TENCENT_OCR_TIMEOUT_MS=60000
TENCENT_OCR_USE_NEW_MODEL=false
TENCENT_OCR_ENABLE_IMAGE_CROP=false
TENCENT_OCR_ENABLE_ONLY_DETECT_BORDER=false
TENCENT_OCR_REAL_SMOKE=false
